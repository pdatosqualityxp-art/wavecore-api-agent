# ==========================================
# WaveCore Backend 3 - Environment Variables
# ==========================================

# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
# Lista de orígenes permitidos para CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000

# Supabase Configuration (Obtenido de tu panel de Supabase -> Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-supabase-anon-key-o-service-role

# Autenticación JWT. Con claves de firma asimétricas (ES256, por defecto en Supabase) se valida
# con la clave pública publicada en SUPABASE_URL/auth/v1/.well-known/jwks.json; no requiere secreto.
# SUPABASE_JWT_SECRET (Legacy JWT Secret, HS256) solo es necesario para tokens firmados con la clave antigua.
SUPABASE_JWT_SECRET=
# false solo en desarrollo local: permite llamar a /api/v1/chat sin token (user queda NULL en chat_logs)
AUTH_ENABLED=true

# Google Gemini API Configuration (Obtenido de Google AI Studio)
GOOGLE_API_KEY=tu-api-key-de-gemini

# Modelos de Gemini
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Reintentos del modelo conversacional ante fallos transitorios antes de pasar al fallback
GEMINI_MAX_RETRIES=2
# Turnos previos de chat_logs que se cargan como memoria del agente
CHAT_HISTORY_TURNS=10